name: Update NFL Closing Lines

on:
  workflow_dispatch:
  schedule:
    - cron: "*/5 13-23 * * 0"
    - cron: "*/5 22-23 * * 1,4"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Append verified NFL closing lines
        shell: bash
        run: |
          python - <<'PY'
          import json
          import re
          import urllib.request
          from datetime import datetime, timezone
          from pathlib import Path
          from zoneinfo import ZoneInfo

          ESPN = (
              "https://site.api.espn.com/apis/site/v2/"
              "sports/football/nfl/scoreboard"
          )

          STATMUSE = (
              "https://r.jina.ai/"
              "https://www.statmuse.com/nfl/ask/"
              "what-are-the-odds-for-the-nfl-games-this-weekend"
          )

          OUT = Path("closing-lines.json")


          def fetch_text(url):
              req = urllib.request.Request(
                  url,
                  headers={
                      "User-Agent":
                          "Mozilla/5.0 FootballFairPriceLookup/1.0"
                  },
              )

              with urllib.request.urlopen(
                  req,
                  timeout=30,
              ) as response:

                  return response.read().decode(
                      "utf-8",
                      errors="replace",
                  )


          def fetch_json(url):
              return json.loads(
                  fetch_text(url)
              )


          def clean(text):
              text = (
                  text
                  .replace("−", "-")
                  .replace("–", "-")
                  .replace("—", "-")
              )

              #
              # Jina sometimes changes links to:
              #
              # 【40†Los Angeles Rams】
              #
              # Convert those back to:
              #
              # Los Angeles Rams
              #

              text = re.sub(
                  r"【\d+†([^】]+)】",
                  r"\1",
                  text,
              )

              return text


          def parse_statmuse(
              text,
              away_name,
              home_name,
          ):

              text = clean(text)


              #
              # Only use the page when StatMuse
              # explicitly identifies the table
              # as consensus closing odds.
              #

              if not re.search(
                  r"Consensus closing odds",
                  text,
                  flags=re.I,
              ):
                  return None


              away_pattern = re.escape(
                  away_name
              )

              home_pattern = re.escape(
                  home_name
              )


              #
              # Typical row:
              #
              # | | Los Angeles Rams | -177 | @ |
              # Las Vegas Raiders | +148 | ...
              #
              # Extra blank columns do not matter.
              #

              pattern_away_first = re.compile(
                  away_pattern
                  +
                  r"\s*\|\s*"
                  r"([+-]\d+)"
                  +
                  r"\s*\|\s*"
                  r"(?:@|vs)"
                  +
                  r"\s*\|\s*"
                  +
                  home_pattern
                  +
                  r"\s*\|\s*"
                  r"([+-]\d+)",
                  flags=re.I,
              )


              match = pattern_away_first.search(
                  text
              )


              if match:

                  return (
                      int(
                          match.group(1)
                      ),
                      int(
                          match.group(2)
                      ),
                  )


              #
              # Some StatMuse pages show the
              # home team first:
              #
              # Detroit Lions | -194 | vs |
              # Green Bay Packers | +161
              #
              # Convert back to ESPN's
              # away/home ordering.
              #

              pattern_home_first = re.compile(
                  home_pattern
                  +
                  r"\s*\|\s*"
                  r"([+-]\d+)"
                  +
                  r"\s*\|\s*"
                  r"(?:@|vs)"
                  +
                  r"\s*\|\s*"
                  +
                  away_pattern
                  +
                  r"\s*\|\s*"
                  r"([+-]\d+)",
                  flags=re.I,
              )


              match = pattern_home_first.search(
                  text
              )


              if match:

                  home_ml = int(
                      match.group(1)
                  )

                  away_ml = int(
                      match.group(2)
                  )

                  return (
                      away_ml,
                      home_ml,
                  )


              return None


          #
          # LOAD EXISTING FILE
          #

          if OUT.exists():

              data = json.loads(
                  OUT.read_text()
              )

          else:

              data = {
                  "updated_at": None,
                  "games": {},
              }


          if "games" not in data:

              data["games"] = {}


          games = data[
              "games"
          ]


          original_text = json.dumps(
              data,
              sort_keys=True,
          )


          #
          # ESPN TODAY
          #

          now_et = datetime.now(
              ZoneInfo(
                  "America/New_York"
              )
          )


          today = now_et.strftime(
              "%Y%m%d"
          )


          scoreboard = fetch_json(
              f"{ESPN}"
              f"?limit=100"
              f"&dates={today}"
          )


          #
          # FETCH STATMUSE ONCE
          #

          try:

              statmuse_text = fetch_text(
                  STATMUSE
              )


              print(
                  "StatMuse closing table loaded."
              )


              if re.search(
                  r"Consensus closing odds",
                  statmuse_text,
                  flags=re.I,
              ):

                  print(
                      "Verified: Consensus closing odds table."
                  )

              else:

                  print(
                      "WARNING: closing-odds label not found."
                  )


          except Exception as exc:

              statmuse_text = ""

              print(
                  "StatMuse fetch failed:",
                  exc,
              )


          added = 0


          #
          # APPEND ONLY
          #

          for event in scoreboard.get(
              "events",
              [],
          ):

              competitions = (
                  event.get(
                      "competitions"
                  )
                  or
                  []
              )


              if not competitions:

                  continue


              competition = competitions[
                  0
              ]


              state = (
                  competition
                  .get(
                      "status",
                      {},
                  )
                  .get(
                      "type",
                      {},
                  )
                  .get(
                      "state"
                  )
              )


              #
              # Never capture before kickoff.
              #

              if state not in (
                  "in",
                  "post",
              ):

                  continue


              game_id = str(
                  event.get(
                      "id"
                  )
              )


              #
              # Critical:
              # never touch an existing stored game.
              #

              if game_id in games:

                  print(
                      "Already stored, preserving:",
                      game_id,
                  )

                  continue


              competitors = competition.get(
                  "competitors",
                  [],
              )


              away = next(
                  (
                      team
                      for team
                      in competitors
                      if team.get(
                          "homeAway"
                      )
                      ==
                      "away"
                  ),
                  None,
              )


              home = next(
                  (
                      team
                      for team
                      in competitors
                      if team.get(
                          "homeAway"
                      )
                      ==
                      "home"
                  ),
                  None,
              )


              if not away or not home:

                  continue


              away_name = (
                  away
                  .get(
                      "team",
                      {},
                  )
                  .get(
                      "displayName"
                  )
              )


              home_name = (
                  home
                  .get(
                      "team",
                      {},
                  )
                  .get(
                      "displayName"
                  )
              )


              if not away_name or not home_name:

                  continue


              print()
              print(
                  "Checking:",
                  away_name,
                  "at",
                  home_name,
              )


              if not statmuse_text:

                  print(
                      "StatMuse unavailable."
                  )

                  continue


              closing = parse_statmuse(
                  statmuse_text,
                  away_name,
                  home_name,
              )


              if closing is None:

                  print(
                      "No StatMuse row matched."
                  )

                  continue


              away_ml, home_ml = closing


              games[
                  game_id
              ] = {

                  "event_id":
                      game_id,

                  "away":
                      away_name,

                  "home":
                      home_name,

                  "away_ml":
                      away_ml,

                  "home_ml":
                      home_ml,

                  "source":
                      "StatMuse consensus closing odds",

              }


              added += 1


              print(
                  "ADDED:",
                  away_name,
                  away_ml,
                  "/",
                  home_name,
                  home_ml,
              )


          #
          # WRITE ONLY WHEN SOMETHING
          # WAS ACTUALLY ADDED
          #

          new_text = json.dumps(
              data,
              sort_keys=True,
          )


          if new_text == original_text:

              print()
              print(
                  "No additions."
              )

              print(
                  "Existing closing-lines.json left untouched."
              )


          else:

              data[
                  "updated_at"
              ] = (
                  datetime
                  .now(
                      timezone.utc
                  )
                  .isoformat()
              )


              OUT.write_text(
                  json.dumps(
                      data,
                      indent=2,
                      sort_keys=True,
                  )
                  +
                  "\n"
              )


              print()
              print(
                  "Added",
                  added,
                  "new closing lines."
              )


          print(
              "Total stored games:",
              len(
                  games
              ),
          )

          PY


      - name: Commit only if JSON changed
        shell: bash
        run: |

          if [ -z "$(git status --porcelain -- closing-lines.json)" ]; then

            echo "No JSON changes to commit."

            exit 0

          fi


          git config \
            user.name \
            "github-actions[bot]"


          git config \
            user.email \
            "41898282+github-actions[bot]@users.noreply.github.com"


          git add \
            closing-lines.json


          git commit \
            -m \
            "Append NFL closing lines"


          git push
