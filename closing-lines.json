name: Update NFL Closing Lines

on:
  workflow_dispatch:
  schedule:
    - cron: "*/5 13-23 * * 0"
    - cron: "*/5 22-23 * * 1,4"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Append verified NFL closing lines
        shell: bash
        run: |
          python - <<'PY'
          import json
          import re
          import urllib.request
          from datetime import datetime, timezone
          from pathlib import Path
          from zoneinfo import ZoneInfo

          ESPN = (
              "https://site.api.espn.com/apis/site/v2/"
              "sports/football/nfl/scoreboard"
          )

          STATMUSE = (
              "https://r.jina.ai/http://www.statmuse.com/"
              "nfl/ask/nfl-moneylines"
          )

          OUT = Path("closing-lines.json")


          def fetch_text(url):
              req = urllib.request.Request(
                  url,
                  headers={
                      "User-Agent":
                          "Mozilla/5.0",
                      "Accept":
                          "application/json,text/plain,text/html,*/*",
                  },
              )

              with urllib.request.urlopen(
                  req,
                  timeout=30,
              ) as response:

                  return response.read().decode(
                      "utf-8",
                      errors="replace",
                  )


          def fetch_json(url):
              text = fetch_text(url)

              if not text.strip():
                  raise RuntimeError(
                      "Empty response from: " + url
                  )

              try:
                  return json.loads(text)

              except Exception:
                  print(
                      "NON-JSON RESPONSE FROM:",
                      url,
                  )

                  print(
                      "FIRST 500 CHARACTERS:"
                  )

                  print(
                      text[:500]
                  )

                  raise


          def clean(text):
              return (
                  text
                  .replace("−", "-")
                  .replace("–", "-")
                  .replace("—", "-")
              )


          def strip_jina_links(text):
              return re.sub(
                  r"【\d+†([^】]+)】",
                  r"\1",
                  text,
              )


          def parse_statmuse(
              text,
              away_name,
              home_name,
          ):
              text = clean(
                  strip_jina_links(text)
              )

              away = re.escape(
                  away_name
              )

              home = re.escape(
                  home_name
              )

              #
              # Away-team-first format
              #

              pattern = re.compile(
                  away
                  +
                  r"[\s|]+"
                  r"([+-]\d+)"
                  +
                  r"[\s|]+"
                  r"(?:@|vs\.?)"
                  +
                  r"[\s|]+"
                  +
                  home
                  +
                  r"[\s|]+"
                  r"([+-]\d+)",
                  flags=re.I,
              )

              match = pattern.search(
                  text
              )

              if match:
                  return (
                      int(match.group(1)),
                      int(match.group(2)),
                  )


              #
              # Home-team-first format
              #

              pattern = re.compile(
                  home
                  +
                  r"[\s|]+"
                  r"([+-]\d+)"
                  +
                  r"[\s|]+"
                  r"(?:@|vs\.?)"
                  +
                  r"[\s|]+"
                  +
                  away
                  +
                  r"[\s|]+"
                  r"([+-]\d+)",
                  flags=re.I,
              )

              match = pattern.search(
                  text
              )

              if match:
                  return (
                      int(match.group(2)),
                      int(match.group(1)),
                  )

              return None


          # -----------------------------------
          # PRESERVE EXISTING CLOSING LINES
          # -----------------------------------

          if OUT.exists():
              try:
                  data = json.loads(
                      OUT.read_text()
                  )

              except Exception as exc:
                  print(
                      "Could not read existing closing-lines.json"
                  )
                  raise

          else:
              data = {
                  "updated_at": None,
                  "games": {},
              }


          games = data.setdefault(
              "games",
              {},
          )


          original_games = json.dumps(
              games,
              sort_keys=True,
          )


          # -----------------------------------
          # ESPN LIVE GAME LIST
          # -----------------------------------

          now_et = datetime.now(
              ZoneInfo(
                  "America/New_York"
              )
          )

          today = now_et.strftime(
              "%Y%m%d"
          )

          espn_url = (
              ESPN
              +
              "?limit=100&dates="
              +
              today
          )


          print(
              "Fetching ESPN:"
          )

          print(
              espn_url
          )


          scoreboard = fetch_json(
              espn_url
          )


          print(
              "ESPN events:",
              len(
                  scoreboard.get(
                      "events",
                      [],
                  )
              )
          )


          # -----------------------------------
          # STATMUSE
          # -----------------------------------

          statmuse_text = ""

          try:
              statmuse_text = fetch_text(
                  STATMUSE
              )

              print(
                  "StatMuse loaded:",
                  len(statmuse_text),
                  "characters"
              )

          except Exception as exc:
              print(
                  "StatMuse fetch failed:",
                  exc,
              )


          added = 0


          # -----------------------------------
          # APPEND ONLY
          # -----------------------------------

          for event in scoreboard.get(
              "events",
              [],
          ):

              comps = (
                  event.get(
                      "competitions"
                  )
                  or
                  []
              )

              if not comps:
                  continue


              competition = comps[0]


              state = (
                  competition
                  .get(
                      "status",
                      {},
                  )
                  .get(
                      "type",
                      {},
                  )
                  .get(
                      "state"
                  )
              )


              if state not in (
                  "in",
                  "post",
              ):
                  continue


              game_id = str(
                  event.get(
                      "id"
                  )
              )


              if game_id in games:

                  print(
                      "Preserving existing:",
                      game_id,
                  )

                  continue


              competitors = (
                  competition.get(
                      "competitors",
                      []
                  )
              )


              away = next(
                  (
                      x
                      for x in competitors
                      if x.get(
                          "homeAway"
                      )
                      ==
                      "away"
                  ),
                  None,
              )


              home = next(
                  (
                      x
                      for x in competitors
                      if x.get(
                          "homeAway"
                      )
                      ==
                      "home"
                  ),
                  None,
              )


              if not away or not home:
                  continue


              away_name = (
                  away
                  .get(
                      "team",
                      {},
                  )
                  .get(
                      "displayName"
                  )
              )


              home_name = (
                  home
                  .get(
                      "team",
                      {},
                  )
                  .get(
                      "displayName"
                  )
              )


              print()
              print(
                  "Checking:",
                  away_name,
                  "at",
                  home_name,
              )


              closing = None


              if statmuse_text:

                  closing = parse_statmuse(
                      statmuse_text,
                      away_name,
                      home_name,
                  )


              if closing is None:

                  print(
                      "No verified closing line matched."
                  )

                  continue


              away_ml, home_ml = closing


              games[
                  game_id
              ] = {

                  "event_id":
                      game_id,

                  "away":
                      away_name,

                  "home":
                      home_name,

                  "away_ml":
                      away_ml,

                  "home_ml":
                      home_ml,

                  "source":
                      "StatMuse closing odds",

              }


              added += 1


              print(
                  "ADDED:",
                  away_name,
                  away_ml,
                  "/",
                  home_name,
                  home_ml,
              )


          # -----------------------------------
          # SAVE ONLY IF GAMES CHANGED
          # -----------------------------------

          new_games = json.dumps(
              games,
              sort_keys=True,
          )


          if new_games == original_games:

              print()
              print(
                  "No new games added."
              )

              print(
                  "Existing JSON preserved unchanged."
              )


          else:

              data[
                  "updated_at"
              ] = (
                  datetime
                  .now(
                      timezone.utc
                  )
                  .isoformat()
              )


              OUT.write_text(
                  json.dumps(
                      data,
                      indent=2,
                      sort_keys=True,
                  )
                  +
                  "\n"
              )


              print()
              print(
                  "Added",
                  added,
                  "new game(s)."
              )


          print(
              "Total stored:",
              len(games)
          )

          PY


      - name: Commit only if JSON changed
        shell: bash
        run: |
          if [ -z "$(git status --porcelain -- closing-lines.json)" ]; then
            echo "No JSON changes."
            exit 0
          fi

          git config user.name "github-actions[bot]"
          git config user.email \
            "41898282+github-actions[bot]@users.noreply.github.com"

          git add closing-lines.json
          git commit -m "Append NFL closing lines"
          git push
