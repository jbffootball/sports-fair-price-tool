
name: Update College Pregame Odds

on:
  workflow_dispatch:
  schedule:
    - cron: '*/10 * * * 5,6'
    - cron: '*/15 0-8 * * 0'

permissions:
  contents: write

concurrency:
  group: college-closing-lines
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Capture ESPN verified college pregame moneylines
        shell: bash
        run: |
          python - <<'PY'
          import json
          import time
          import urllib.error
          import urllib.request
          from datetime import datetime, timedelta, timezone
          from pathlib import Path
          from zoneinfo import ZoneInfo

          FILE = Path('college-closing-lines.json')
          REPORT = Path('college-odds-diagnostics.json')
          SCOREBOARD = 'https://site.api.espn.com/apis/site/v2/sports/football/college-football/scoreboard'
          CORE = 'https://sports.core.api.espn.com/v2/sports/football/leagues/college-football'
          EASTERN = ZoneInfo('America/New_York')
          NOW = datetime.now(timezone.utc)
          failures = []
          missing = []
          checked = 0
          added = 0
          api_ok = 0

          def get_json(url):
              headers = {
                  'User-Agent': 'Mozilla/5.0 (compatible; college-odds-capture/1.0)',
                  'Accept': 'application/json',
                  'Origin': 'https://www.espn.com',
                  'Referer': 'https://www.espn.com/',
              }
              for attempt in range(3):
                  try:
                      request = urllib.request.Request(url, headers=headers)
                      with urllib.request.urlopen(request, timeout=20) as response:
                          return json.load(response)
                  except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, ValueError) as error:
                      if attempt == 2 or (isinstance(error, urllib.error.HTTPError) and error.code not in (429, 500, 502, 503, 504)):
                          raise
                      time.sleep(attempt + 1)

          def moneyline(value):
              if isinstance(value, dict):
                  value = value.get('american', value.get('value', value.get('displayValue')))
              if isinstance(value, str):
                  value = value.strip().replace(',', '').upper()
                  if value in ('EVEN', 'EVENS', 'EV'): return 100
                  value = value.replace('+', '')
              try:
                  n = int(value)
                  return n if 100 <= abs(n) <= 100000 else None
              except (TypeError, ValueError):
                  return None

          def implied(american):
              return (-american / (100 - american)) if american < 0 else (100 / (100 + american))

          def ranked(event):
              competition = (event.get('competitions') or [{}])[0]
              for side in competition.get('competitors', []):
                  rank = (side.get('curatedRank') or {}).get('current', 99)
                  try:
                      if 1 <= int(rank) <= 25: return True
                  except (ValueError, TypeError):
                      pass
              return False

          def team_names(competition):
              sides = {x.get('homeAway'): (x.get('team') or {}).get('displayName')
                       for x in competition.get('competitors', [])}
              if not sides.get('away') or not sides.get('home'):
                  raise ValueError('Missing home or away team')
              return sides['away'], sides['home']

          def side_moneyline(row, side, snapshot):
              block = row.get(side + 'TeamOdds') or {}
              if snapshot == 'top':
                  return moneyline(block.get('moneyLine'))
              snap = block.get(snapshot) or {}
              return moneyline(snap.get('moneyLine'))

          def find_line(items, kickoff):
              # Closing lines after kickoff are explicitly labeled by ESPN.
              # Undated current lines are accepted only before kickoff.
              prior_to_kickoff = NOW < kickoff
              choices = []
              for row in items:
                  if not isinstance(row, dict): continue
                  provider = row.get('provider') or {}
                  provider_name = str(provider.get('name') or 'Unknown provider')
                  try:
                      priority = int(provider.get('priority', 999))
                  except (ValueError, TypeError):
                      priority = 999
                  snapshots = ['current', 'top'] if prior_to_kickoff else ['close']
                  for order, snap in enumerate(snapshots):
                      away = side_moneyline(row, 'away', snap)
                      home = side_moneyline(row, 'home', snap)
                      if away is None or home is None: continue
                      choices.append((order, priority, provider_name, away, home, snap))
              if not choices: return None
              choices.sort()
              _, _, provider, away, home, snapshot = choices[0]
              return away, home, f'ESPN Core {provider} {snapshot} moneyline', snapshot

          if not FILE.exists():
              raise RuntimeError('Historical college odds JSON missing: refusing to create an empty replacement')
          original = json.loads(FILE.read_text())
          if not isinstance(original, dict) or not isinstance(original.get('games'), dict):
              raise RuntimeError('Historical college odds JSON malformed: refusing to overwrite')
          games = original['games']
          existing = len(games)
          today = NOW.astimezone(EASTERN).date()

          for date in (today - timedelta(days=1), today, today + timedelta(days=1)):
              day = date.strftime('%Y%m%d')
              try:
                  scoreboard = get_json(f'{SCOREBOARD}?dates={day}&groups=80&limit=500')
              except Exception as error:
                  failures.append(f'SCOREBOARD {day}: {error}')
                  print('ERROR_SCOREBOARD', day, str(error))
                  continue
              events = scoreboard.get('events') or []
              selected = [event for event in events if ranked(event)]
              print('DAY', day, 'scoreboard_games', len(events), 'ranked_games', len(selected))
              for event in selected:
                  event_id = str(event.get('id') or '')
                  if not event_id or event_id in games: continue
                  competition = (event.get('competitions') or [{}])[0]
                  competition_id = str(competition.get('id') or event_id)
                  try:
                      away_name, home_name = team_names(competition)
                      kickoff = datetime.fromisoformat(event['date'].replace('Z', '+00:00'))
                  except (ValueError, TypeError, KeyError) as error:
                      missing.append({'event_id': event_id, 'reason': f'Invalid ESPN game metadata: {error}'})
                      continue
                  checked += 1
                  url = f'{CORE}/events/{event_id}/competitions/{competition_id}/odds?lang=en&region=us&limit=100'
                  try:
                      response = get_json(url)
                      api_ok += 1
                      items = response.get('items') or []
                      line = find_line(items, kickoff)
                  except Exception as error:
                      failures.append(f'ODDS {event_id}: {error}')
                      line = None
                  if not line:
                      missing.append({'event_id': event_id, 'away': away_name,
                                      'home': home_name, 'reason': 'No verifiable pregame moneyline pair'})
                      continue
                  away_ml, home_ml, source, snapshot = line
                  a, h = implied(away_ml), implied(home_ml)
                  fair_away, fair_home = a/(a+h), h/(a+h)
                  capture_time = datetime.now(timezone.utc).isoformat()
                  games[event_id] = {
                      'event_id': event_id,
                      'date': kickoff.astimezone(EASTERN).date().isoformat(),
                      'away': away_name, 'home': home_name,
                      'away_ml': away_ml, 'home_ml': home_ml,
                      'away_fair_probability': round(fair_away, 6),
                      'home_fair_probability': round(fair_home, 6),
                      'pregame_favorite': away_name if fair_away > fair_home else home_name,
                      'favorite_probability': round(max(fair_away, fair_home), 6),
                      'source': source, 'source_url': url,
                      'odds_timestamp': capture_time if snapshot != 'close' else None,
                      'captured_at': capture_time
                  }
                  added += 1
                  print('SAVED', event_id, away_name, away_ml, home_name, home_ml, source)

          if added:
              original['updated_at'] = datetime.now(timezone.utc).isoformat()
              FILE.write_text(json.dumps(original, indent=2, sort_keys=True) + '\n')
          REPORT.write_text(json.dumps({
              'checked_at': NOW.isoformat(), 'old_records': existing,
              'new_records': added, 'total_records': len(games),
              'eligible_missing': missing, 'source_errors': failures,
              'odds_requests': checked, 'successful_odds_requests': api_ok
          }, indent=2) + '\n')
          print('SUMMARY', 'historical', existing, 'added', added,
                'total', len(games), 'candidates', checked, 'odds_api_ok', api_ok,
                'missing', len(missing), 'errors', len(failures))
          if missing:
              print(f'::warning::{len(missing)} college games still lack verified pregame odds; see diagnostic artifact')
          if checked and not api_ok:
              raise RuntimeError('All ESPN Core odds requests failed; see diagnostic artifact')
          PY

      - name: Commit new college odds only
        shell: bash
        run: |
          if [ -z "$(git status --porcelain -- college-closing-lines.json)" ]; then
            echo 'No new verified odds to commit'
            exit 0
          fi
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add college-closing-lines.json
          git commit -m 'Capture verified ESPN college pregame moneylines'
          git push

      - name: Upload college odds diagnostic report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: college-odds-diagnostics
          path: college-odds-diagnostics.json
          if-no-files-found: ignore
          retention-days: 7
